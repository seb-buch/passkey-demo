# Database path (relative to project root)
DB_PATH="krabsvault.db"

# Session secret key (auto-generated if not set)
# SECRET_KEY="your-secret-key-here"

# Seed users (JSON array — plaintext passwords, hashed at startup with argon2).
# Optional per-user "totp_secret" (base32) + "mfa_enabled":true pre-enrolls MFA,
# so you never have to re-scan the QR after a DB reset — add the secret to your
# authenticator app once and it stays valid across demos.
USERS='[{"username":"bob","display_name":"SpongeBob SquarePants","password":"test","totp_secret":"6SAKPDKILMN6GJKHE7XKFQC5O2WMB7J2","mfa_enabled":true}]'

# WebAuthn Relying Party settings
RP_ID="localhost"
RP_NAME="KrabsVault"
RP_ORIGIN="http://localhost:8000"
